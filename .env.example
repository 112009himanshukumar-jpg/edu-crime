# Required in production: set a unique long random secret.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Local development (default): use Ollama running on this computer.
AI_PROVIDER=ollama
OLLAMA_MODEL=gemma3:270m

# Hosted deployment example: use a hosted OpenAI-compatible AI provider.
# Set AI_PROVIDER=groq and provide GROQ_API_KEY in your host's secret settings.
# AI_PROVIDER=groq
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=keep-this-secret

HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
# Set to 1 only when served over HTTPS.
SESSION_COOKIE_SECURE=0
# Optional: use a persistent mounted directory for profile JSON storage.
# DATA_DIR=/var/data
